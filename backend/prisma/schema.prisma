generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String               @id @default(dbgenerated("uuidv7()")) @db.Uuid
  email               String?              @unique
  passwordHash        String?              @map("password_hash")
  displayName         String?              @map("display_name")
  role                UserRole             @default(user)
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  sessions            AuthSession[]
  passwordResetTokens PasswordResetToken[]
  avatars             UserAvatar[]
  externalIdentities  ExternalIdentity[]
  ownedFamilies       Family[]             @relation("FamilyOwner")
  familyMemberships   FamilyMember[]
  createdInvites      FamilyInvite[]       @relation("InviteCreator")
  acceptedInvites     FamilyInvite[]       @relation("InviteAcceptor")
  idempotencyRecords  IdempotencyRecord[]
  authoredMemories    Memory[]             @relation("MemoryAuthor")
  uploadedMedia       MediaAsset[]         @relation("MediaUploader")
  mediaReservations   UploadReservation[]

  @@index([role], map: "users_role_idx")
  @@map("users")
}

model ExternalIdentity {
  id        String                   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId    String                   @map("user_id") @db.Uuid
  provider  ExternalIdentityProvider
  subject   String
  createdAt DateTime                 @default(now()) @map("created_at")
  updatedAt DateTime                 @updatedAt @map("updated_at")
  user      User                     @relation(fields: [userId], references: [id], onDelete: Cascade, map: "external_identities_user_id_fkey")

  @@unique([provider, subject], map: "external_identities_provider_subject_key")
  @@index([userId], map: "external_identities_user_id_idx")
  @@map("external_identities")
}

model TelegramAuthReplay {
  fingerprintHash String       @id @map("fingerprint_hash")
  sessionId       String?      @map("session_id") @db.Uuid
  expiresAt       DateTime     @map("expires_at")
  createdAt       DateTime     @default(now()) @map("created_at")
  session         AuthSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade, map: "telegram_auth_replays_session_id_fkey")

  @@index([expiresAt], map: "telegram_auth_replays_expires_at_idx")
  @@map("telegram_auth_replays")
}

model PilotAdmission {
  id         String                   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  provider   ExternalIdentityProvider
  subject    String
  admittedAt DateTime                 @default(now()) @map("admitted_at")
  revokedAt  DateTime?                @map("revoked_at")
  createdAt  DateTime                 @default(now()) @map("created_at")
  updatedAt  DateTime                 @updatedAt @map("updated_at")

  @@unique([provider, subject], map: "pilot_admissions_provider_subject_key")
  @@index([revokedAt], map: "pilot_admissions_revoked_at_idx")
  @@map("pilot_admissions")
}

model Family {
  id                   String              @id @default(dbgenerated("uuidv7()")) @db.Uuid
  ownerUserId          String              @map("owner_user_id") @db.Uuid
  name                 String
  timezone             String
  status               FamilyStatus        @default(active)
  storageUsedBytes     BigInt              @default(0) @map("storage_used_bytes")
  storageReservedBytes BigInt              @default(0) @map("storage_reserved_bytes")
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")
  owner                User                @relation("FamilyOwner", fields: [ownerUserId], references: [id], onDelete: Restrict, map: "families_owner_user_id_fkey")
  members              FamilyMember[]      @relation("FamilyMembers")
  ownerMembership      FamilyMember        @relation("FamilyOwnerMembership", fields: [id, ownerUserId], references: [familyId, userId], onDelete: Restrict, map: "families_owner_membership_fkey")
  children             Child[]
  invites              FamilyInvite[]
  memories             Memory[]
  mediaAssets          MediaAsset[]
  mediaReservations    UploadReservation[]

  @@unique([id, ownerUserId], map: "families_owner_pair_key")
  @@index([ownerUserId], map: "families_owner_user_id_idx")
  @@map("families")
}

model FamilyMember {
  familyId          String              @map("family_id") @db.Uuid
  userId            String              @map("user_id") @db.Uuid
  role              FamilyRole
  joinedAt          DateTime            @default(now()) @map("joined_at")
  revokedAt         DateTime?           @map("revoked_at")
  family            Family              @relation("FamilyMembers", fields: [familyId], references: [id], onDelete: Cascade, map: "family_members_family_id_fkey")
  ownedFamily       Family?             @relation("FamilyOwnerMembership")
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade, map: "family_members_user_id_fkey")
  memoryLikes       MemoryLike[]
  authoredMemories  Memory[]            @relation("MemoryAuthorMembership")
  uploadedMedia     MediaAsset[]        @relation("MediaUploaderMembership")
  mediaReservations UploadReservation[] @relation("MediaReservationMembership")

  @@id([familyId, userId])
  @@index([userId, revokedAt], map: "family_members_user_id_revoked_at_idx")
  @@map("family_members")
}

model Child {
  id            String      @id @default(dbgenerated("uuidv7()")) @db.Uuid
  familyId      String      @map("family_id") @db.Uuid
  displayName   String      @map("display_name")
  birthDate     DateTime?   @map("birth_date") @db.Date
  avatarMediaId String?     @unique(map: "children_avatar_media_id_key") @map("avatar_media_id") @db.Uuid
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")
  family        Family      @relation(fields: [familyId], references: [id], onDelete: Cascade, map: "children_family_id_fkey")
  memories      Memory[]
  avatarMedia   MediaAsset? @relation("ChildAvatar", fields: [avatarMediaId, familyId], references: [id, familyId], onDelete: Restrict, map: "children_avatar_media_id_family_id_fkey")

  @@unique([id, familyId], map: "children_id_family_id_key")
  @@index([familyId], map: "children_family_id_idx")
  @@map("children")
}

model FamilyInvite {
  id         String     @id @default(dbgenerated("uuidv7()")) @db.Uuid
  familyId   String     @map("family_id") @db.Uuid
  role       FamilyRole
  tokenHash  String     @unique(map: "family_invites_token_hash_key") @map("token_hash")
  expiresAt  DateTime   @map("expires_at")
  createdBy  String     @map("created_by") @db.Uuid
  acceptedBy String?    @map("accepted_by") @db.Uuid
  acceptedAt DateTime?  @map("accepted_at")
  revokedAt  DateTime?  @map("revoked_at")
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")
  family     Family     @relation(fields: [familyId], references: [id], onDelete: Cascade, map: "family_invites_family_id_fkey")
  creator    User       @relation("InviteCreator", fields: [createdBy], references: [id], onDelete: Restrict, map: "family_invites_created_by_fkey")
  acceptor   User?      @relation("InviteAcceptor", fields: [acceptedBy], references: [id], onDelete: Restrict, map: "family_invites_accepted_by_fkey")

  @@index([familyId, expiresAt], map: "family_invites_family_id_expires_at_idx")
  @@map("family_invites")
}

model IdempotencyRecord {
  id               String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  actorUserId      String   @map("actor_user_id") @db.Uuid
  operation        String
  key              String   @db.Uuid
  payloadHash      String   @map("payload_hash")
  resourceId       String   @map("resource_id") @db.Uuid
  responseSnapshot Json     @map("response_snapshot")
  expiresAt        DateTime @map("expires_at")
  createdAt        DateTime @default(now()) @map("created_at")
  actor            User     @relation(fields: [actorUserId], references: [id], onDelete: Cascade, map: "idempotency_records_actor_user_id_fkey")

  @@unique([actorUserId, operation, key], map: "idempotency_records_actor_operation_key_key")
  @@index([expiresAt], map: "idempotency_records_expires_at_idx")
  @@map("idempotency_records")
}

model Memory {
  id               String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  familyId         String        @map("family_id") @db.Uuid
  childId          String        @map("child_id") @db.Uuid
  authorId         String        @map("author_id") @db.Uuid
  kind             MemoryKind
  body             String
  occurredAt       DateTime      @map("occurred_at") @db.Timestamptz(6)
  status           MemoryStatus  @default(published)
  version          Int           @default(1)
  createdSequence  BigInt        @default(autoincrement()) @map("created_sequence")
  deletedAt        DateTime?     @map("deleted_at") @db.Timestamptz(6)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  family           Family        @relation(fields: [familyId], references: [id], onDelete: Cascade, map: "memories_family_id_fkey")
  child            Child         @relation(fields: [childId, familyId], references: [id, familyId], onDelete: Restrict, map: "memories_child_id_family_id_fkey")
  author           User          @relation("MemoryAuthor", fields: [authorId], references: [id], onDelete: Restrict, map: "memories_author_id_fkey")
  authorMembership FamilyMember  @relation("MemoryAuthorMembership", fields: [familyId, authorId], references: [familyId, userId], onDelete: Restrict, map: "memories_author_membership_fkey")
  likes            MemoryLike[]
  media            MemoryMedia[]

  @@unique([id, familyId], map: "memories_id_family_id_key")
  @@index([familyId, status, occurredAt(sort: Desc), id(sort: Desc)], map: "memories_feed_idx")
  @@index([familyId, kind, status, occurredAt(sort: Desc), id(sort: Desc)], map: "memories_kind_feed_idx")
  @@map("memories")
}

model MemoryLike {
  familyId  String       @map("family_id") @db.Uuid
  memoryId  String       @map("memory_id") @db.Uuid
  userId    String       @map("user_id") @db.Uuid
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  memory    Memory       @relation(fields: [memoryId, familyId], references: [id, familyId], onDelete: Cascade, map: "memory_likes_memory_id_family_id_fkey")
  member    FamilyMember @relation(fields: [familyId, userId], references: [familyId, userId], onDelete: Restrict, map: "memory_likes_family_id_user_id_fkey")

  @@id([memoryId, userId])
  @@index([familyId, memoryId], map: "memory_likes_family_id_memory_id_idx")
  @@map("memory_likes")
}

model MemoryMedia {
  familyId String     @map("family_id") @db.Uuid
  memoryId String     @map("memory_id") @db.Uuid
  mediaId  String     @map("media_id") @db.Uuid
  position Int
  memory   Memory     @relation(fields: [memoryId, familyId], references: [id, familyId], onDelete: Cascade, map: "memory_media_memory_id_family_id_fkey")
  asset    MediaAsset @relation(fields: [mediaId, familyId], references: [id, familyId], onDelete: Restrict, map: "memory_media_media_id_family_id_fkey")

  @@id([memoryId, position])
  @@unique([mediaId], map: "memory_media_media_id_key")
  @@index([familyId, mediaId], map: "memory_media_family_id_media_id_idx")
  @@map("memory_media")
}

model MediaAsset {
  id                 String               @id @default(dbgenerated("uuidv7()")) @db.Uuid
  familyId           String               @map("family_id") @db.Uuid
  uploaderId         String               @map("uploader_id") @db.Uuid
  sourceKind         MediaSourceKind      @map("source_kind")
  purpose            MediaAssetPurpose
  mediaKind          MediaAssetKind       @map("media_kind")
  originalKey        String               @unique(map: "media_assets_original_key_key") @map("original_key")
  declaredMime       String               @map("declared_mime")
  verifiedMime       String?              @map("verified_mime")
  sha256             String?
  byteSize           BigInt               @map("byte_size")
  width              Int?
  height             Int?
  durationMs         Int?                 @map("duration_ms")
  originalStatus     MediaOriginalStatus  @default(pending) @map("original_status")
  renditionStatus    MediaRenditionStatus @default(pending) @map("rendition_status")
  deletedAt          DateTime?            @map("deleted_at") @db.Timestamptz(6)
  storageDeletedAt   DateTime?            @map("storage_deleted_at") @db.Timestamptz(6)
  createdAt          DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  family             Family               @relation(fields: [familyId], references: [id], onDelete: Cascade, map: "media_assets_family_id_fkey")
  uploader           User                 @relation("MediaUploader", fields: [uploaderId], references: [id], onDelete: Restrict, map: "media_assets_uploader_id_fkey")
  uploaderMembership FamilyMember         @relation("MediaUploaderMembership", fields: [familyId, uploaderId], references: [familyId, userId], onDelete: Restrict, map: "media_assets_uploader_membership_fkey")
  variants           MediaVariant[]
  reservation        UploadReservation?
  memories           MemoryMedia[]
  avatarForChildren  Child[]              @relation("ChildAvatar")

  @@unique([id, familyId], map: "media_assets_id_family_id_key")
  @@index([familyId, originalStatus, deletedAt], map: "media_assets_family_status_idx")
  @@map("media_assets")
}

model MediaVariant {
  id         String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  familyId   String           @map("family_id") @db.Uuid
  mediaId    String           @map("media_id") @db.Uuid
  variant    MediaVariantKind
  objectKey  String           @unique(map: "media_variants_object_key_key") @map("object_key")
  sha256     String
  byteSize   BigInt           @map("byte_size")
  mime       String
  width      Int?
  height     Int?
  durationMs Int?             @map("duration_ms")
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  asset      MediaAsset       @relation(fields: [mediaId, familyId], references: [id, familyId], onDelete: Cascade, map: "media_variants_media_id_family_id_fkey")

  @@unique([mediaId, variant], map: "media_variants_media_id_variant_key")
  @@index([familyId, mediaId], map: "media_variants_family_id_media_id_idx")
  @@map("media_variants")
}

model UploadReservation {
  id          String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  familyId    String       @map("family_id") @db.Uuid
  userId      String       @map("user_id") @db.Uuid
  mediaId     String       @map("media_id") @db.Uuid
  bytes       BigInt
  expiresAt   DateTime     @map("expires_at") @db.Timestamptz(6)
  finalizedAt DateTime?    @map("finalized_at") @db.Timestamptz(6)
  releasedAt  DateTime?    @map("released_at") @db.Timestamptz(6)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  family      Family       @relation(fields: [familyId], references: [id], onDelete: Cascade, map: "upload_reservations_family_id_fkey")
  user        User         @relation(fields: [userId], references: [id], onDelete: Restrict, map: "upload_reservations_user_id_fkey")
  membership  FamilyMember @relation("MediaReservationMembership", fields: [familyId, userId], references: [familyId, userId], onDelete: Restrict, map: "upload_reservations_membership_fkey")
  asset       MediaAsset   @relation(fields: [mediaId, familyId], references: [id, familyId], onDelete: Cascade, map: "upload_reservations_media_id_family_id_fkey")

  @@unique([mediaId, familyId], map: "upload_reservations_media_id_family_id_key")
  @@index([familyId, expiresAt], map: "upload_reservations_family_expires_idx")
  @@map("upload_reservations")
}

enum ExternalIdentityProvider {
  telegram

  @@map("external_identity_provider")
}

enum FamilyRole {
  full
  viewer

  @@map("family_role")
}

enum FamilyStatus {
  active
  deleting
  deleted

  @@map("family_status")
}

enum MemoryKind {
  note
  photo
  video
  voice

  @@map("memory_kind")
}

enum MemoryStatus {
  processing
  published
  failed
  deleted

  @@map("memory_status")
}

enum MediaSourceKind {
  upload
  telegram

  @@map("media_source_kind")
}

enum MediaAssetPurpose {
  memory
  child_avatar

  @@map("media_asset_purpose")
}

enum MediaAssetKind {
  photo
  video
  voice

  @@map("media_asset_kind")
}

enum MediaOriginalStatus {
  pending
  stored
  failed

  @@map("media_original_status")
}

enum MediaRenditionStatus {
  pending
  ready
  failed

  @@map("media_rendition_status")
}

enum MediaVariantKind {
  preview
  display
  playback

  @@map("media_variant_kind")
}

/// One row per avatar upload attempt. The object itself lives in private storage; this table
/// owns who it belongs to and whether it is finished, because storage cannot answer either.
model UserAvatar {
  id          String          @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId      String          @map("user_id") @db.Uuid
  state       UserAvatarState @default(pending)
  /// Backend-generated and PII-free; see backend/src/storage/object-keys.ts.
  objectKey   String          @unique(map: "user_avatars_object_key_key") @map("object_key")
  contentType String          @map("content_type")
  byteSize    Int             @map("byte_size")
  /// When the signed upload URL stops working, which is also when a pending row becomes junk.
  expiresAt   DateTime        @map("expires_at")
  readyAt     DateTime?       @map("ready_at")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade, map: "user_avatars_user_id_fkey")

  /// The product rule as a database constraint: at most one upload in flight and at most one
  /// live avatar per user, so a lost race fails loudly instead of leaving two live avatars.
  @@unique([userId, state], map: "user_avatars_user_id_state_key")
  @@index([state, expiresAt], map: "user_avatars_state_expires_at_idx")
  @@map("user_avatars")
}

enum UserAvatarState {
  pending
  ready

  @@map("user_avatar_state")
}

model PasswordResetToken {
  id        String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique(map: "password_reset_tokens_token_hash_key") @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade, map: "password_reset_tokens_user_id_fkey")

  @@index([userId, createdAt], map: "password_reset_tokens_user_id_created_at_idx")
  @@index([expiresAt], map: "password_reset_tokens_expires_at_idx")
  @@map("password_reset_tokens")
}

enum UserRole {
  user
  admin

  @@map("user_role")
}

// =============================================================================
// TASK OUTBOX
//
// Durable background work. Keep this block contiguous: the `mobile` branch keeps
// its schema in `prisma/schema/`, so merging means moving these two declarations
// into `prisma/schema/outbox.prisma` unchanged.
// =============================================================================

/// Work that must survive a process restart. `background-tasks.ts` defers work whose loss is
/// acceptable; this table is for work whose loss is not. Rows are claimed and run by the
/// `outbox:drain` job - see docs/BACKGROUND_JOBS.md.
model TaskOutbox {
  id              String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  /// Validated in code against the handler registry, not by a database enum, so adding a task
  /// type stays a code change. See backend/src/outbox/handlers.ts.
  type            String
  /// The idempotency boundary. The caller chooses how wide the window is by what it puts here.
  dedupeKey       String           @map("dedupe_key")
  /// Blanked to `{}` once the task reaches a terminal status; the row itself is kept for audit.
  payload         Json
  status          TaskOutboxStatus @default(pending)
  /// Due time. Retries move it into the future; a recovered lease moves it back to now.
  scheduledFor    DateTime         @default(now()) @map("scheduled_for")
  attempts        Int              @default(0)
  lastError       String?          @map("last_error")
  /// Fencing token held by the process currently running this row. Every write after the claim
  /// re-asserts it, so a process that lost its lease cannot overwrite the winner's result.
  processingToken String?          @map("processing_token") @db.Uuid
  processedAt     DateTime?        @map("processed_at")
  redactedAt      DateTime?        @map("redacted_at")
  createdAt       DateTime         @default(now()) @map("created_at")
  /// Doubles as the lease clock: Prisma bumps it on the claiming `updateMany`, and a row whose
  /// lease went stale is requeued with `attempts` untouched.
  updatedAt       DateTime         @updatedAt @map("updated_at")

  /// No user relation on purpose: a generic outbox must not lose queued work when a user row
  /// goes away, and a task may be keyed on something that is not a user at all. A task that
  /// needs a user id carries it in the payload.
  @@unique([type, dedupeKey], map: "task_outbox_type_dedupe_key_key")
  @@index([status, scheduledFor], map: "task_outbox_status_scheduled_for_idx")
  @@index([status, processedAt], map: "task_outbox_status_processed_at_idx")
  @@map("task_outbox")
}

/// `skipped` is not needed for correctness. It exists so that a system where every task
/// deliberately does nothing looks different from a healthy one in the drain metrics.
enum TaskOutboxStatus {
  pending
  processing
  done
  skipped
  failed

  @@map("task_outbox_status")
}

model AuthSession {
  id                       String               @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId                   String               @map("user_id") @db.Uuid
  refreshTokenHash         String               @unique(map: "auth_sessions_refresh_token_hash_key") @map("refresh_token_hash")
  refreshTokenFamilyHash   String?              @unique(map: "auth_sessions_refresh_token_family_hash_key") @map("refresh_token_family_hash")
  previousRefreshTokenHash String?              @unique(map: "auth_sessions_previous_refresh_token_hash_key") @map("previous_refresh_token_hash")
  refreshRotatedAt         DateTime?            @map("refresh_rotated_at")
  expiresAt                DateTime             @map("expires_at")
  revokedAt                DateTime?            @map("revoked_at")
  userAgent                String?              @map("user_agent")
  ipAddress                String?              @map("ip_address")
  createdAt                DateTime             @default(now()) @map("created_at")
  updatedAt                DateTime             @updatedAt @map("updated_at")
  user                     User                 @relation(fields: [userId], references: [id], onDelete: Cascade, map: "auth_sessions_user_id_fkey")
  telegramAuthReplays      TelegramAuthReplay[]

  @@index([userId], map: "auth_sessions_user_id_idx")
  @@index([expiresAt], map: "auth_sessions_expires_at_idx")
  @@map("auth_sessions")
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String               @id @default(dbgenerated("uuidv7()")) @db.Uuid
  email               String?              @unique
  passwordHash        String?              @map("password_hash")
  displayName         String?              @map("display_name")
  role                UserRole             @default(user)
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  sessions            AuthSession[]
  passwordResetTokens PasswordResetToken[]
  avatars             UserAvatar[]
  externalIdentities  ExternalIdentity[]
  ownedFamilies       Family[]             @relation("FamilyOwner")
  familyMemberships   FamilyMember[]
  createdInvites      FamilyInvite[]       @relation("InviteCreator")
  acceptedInvites     FamilyInvite[]       @relation("InviteAcceptor")
  idempotencyRecords  IdempotencyRecord[]
  authoredMemories    Memory[]             @relation("MemoryAuthor")
  uploadedMedia       MediaAsset[]         @relation("MediaUploader")
  mediaReservations   UploadReservation[]
  telegramVideoDeliveryTargets TelegramVideoDeliveryTarget[]

  @@index([role], map: "users_role_idx")
  @@map("users")
}

model ExternalIdentity {
  id        String                   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId    String                   @map("user_id") @db.Uuid
  provider  ExternalIdentityProvider
  subject   String
  createdAt DateTime                 @default(now()) @map("created_at")
  updatedAt DateTime                 @updatedAt @map("updated_at")
  user      User                     @relation(fields: [userId], references: [id], onDelete: Cascade, map: "external_identities_user_id_fkey")

  @@unique([provider, subject], map: "external_identities_provider_subject_key")
  @@index([userId], map: "external_identities_user_id_idx")
  @@map("external_identities")
}

model TelegramAuthReplay {
  fingerprintHash String       @id @map("fingerprint_hash")
  sessionId       String?      @map("session_id") @db.Uuid
  expiresAt       DateTime     @map("expires_at")
  createdAt       DateTime     @default(now()) @map("created_at")
  session         AuthSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade, map: "telegram_auth_replays_session_id_fkey")

  @@index([expiresAt], map: "telegram_auth_replays_expires_at_idx")
  @@map("telegram_auth_replays")
}

model MaxAuthReplay {
  fingerprintHash String       @id @map("fingerprint_hash")
  sessionId       String?      @map("session_id") @db.Uuid
  expiresAt       DateTime     @map("expires_at")
  createdAt       DateTime     @default(now()) @map("created_at")
  session         AuthSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade, map: "max_auth_replays_session_id_fkey")

  @@index([expiresAt], map: "max_auth_replays_expires_at_idx")
  @@map("max_auth_replays")
}

/// Encrypted, durable MAX ingress. Only the normalized event is stored in the temporary payload;
/// its event key remains permanently for provider-event deduplication.
model MaxInbox {
  id                String             @id @default(dbgenerated("uuidv7()")) @db.Uuid
  eventKey          String             @unique(map: "max_inbox_event_key_key") @map("event_key")
  botId             BigInt             @map("bot_id")
  eventKind         MaxInboxEventKind  @map("event_kind")
  encryptedPayload  Bytes              @map("encrypted_payload")
  encryptionIv      Bytes              @map("encryption_iv")
  encryptionAuthTag Bytes              @map("encryption_auth_tag")
  status            MaxInboxStatus     @default(accepted)
  receivedAt        DateTime           @default(now()) @map("received_at") @db.Timestamptz(6)
  processedAt       DateTime?          @map("processed_at") @db.Timestamptz(6)
  source            MaxSource?
  responses         MaxOutgoingResponse[]

  @@index([status, receivedAt], map: "max_inbox_processing_idx")
  @@map("max_inbox")
}

model MaxSource {
  id              String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  inboxId         String           @unique(map: "max_sources_inbox_id_key") @map("inbox_id") @db.Uuid
  botId           BigInt           @map("bot_id")
  senderSubject   String           @map("sender_subject")
  recipientId     BigInt           @map("recipient_id")
  messageId       String           @map("message_id")
  status          MaxSourceStatus  @default(accepted)
  plannedMemoryId String           @map("planned_memory_id") @db.Uuid
  memoryId        String?          @map("memory_id") @db.Uuid
  userId          String?          @map("user_id") @db.Uuid
  familyId        String?          @map("family_id") @db.Uuid
  childId         String?          @map("child_id") @db.Uuid
  rejectionCode   String?          @map("rejection_code")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  inbox           MaxInbox         @relation(fields: [inboxId], references: [id], onDelete: Cascade, map: "max_sources_inbox_id_fkey")
  attachments     MaxSourceAttachment[]

  @@unique([botId, recipientId, messageId], map: "max_sources_bot_recipient_message_key")
  @@index([status, updatedAt], map: "max_sources_status_idx")
  @@map("max_sources")
}

model MaxSourceAttachment {
  id                    String                    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  sourceId              String                    @map("source_id") @db.Uuid
  position              Int
  providerKind          MaxSourceAttachmentKind   @map("provider_kind")
  providerAttachmentId  String                    @map("provider_attachment_id")
  plannedMediaId        String                    @unique(map: "max_source_attachments_planned_media_id_key") @map("planned_media_id") @db.Uuid
  mediaId               String?                   @map("media_id") @db.Uuid
  status                MaxSourceAttachmentStatus @default(planned)
  claimToken            String?                   @map("claim_token") @db.Uuid
  claimUntil            DateTime?                 @map("claim_until") @db.Timestamptz(6)
  createdAt             DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)
  source                MaxSource                  @relation(fields: [sourceId], references: [id], onDelete: Cascade, map: "max_source_attachments_source_id_fkey")

  @@unique([sourceId, position], map: "max_source_attachments_source_position_key")
  @@index([sourceId, providerKind, providerAttachmentId], map: "max_source_attachments_source_kind_provider_idx")
  @@map("max_source_attachments")
}

model MaxOutgoingResponse {
  id                 String                    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  inboxId            String                    @map("inbox_id") @db.Uuid
  destinationUserId  BigInt                    @map("destination_user_id")
  kind               MaxOutgoingResponseKind
  text               String
  deliveredAt        DateTime?                 @map("delivered_at") @db.Timestamptz(6)
  createdAt          DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)
  inbox              MaxInbox                  @relation(fields: [inboxId], references: [id], onDelete: Cascade, map: "max_outgoing_responses_inbox_id_fkey")

  @@unique([inboxId, kind], map: "max_outgoing_responses_inbox_kind_key")
  @@index([deliveredAt, createdAt], map: "max_outgoing_responses_pending_delivery_idx")
  @@map("max_outgoing_responses")
}

/// Encrypted, durable Telegram ingress. The raw Bot API update never enters logs or a public DTO;
/// only the normalized minimum needed by the worker is encrypted here.
model TelegramInbox {
  id                String              @id @default(dbgenerated("uuidv7()")) @db.Uuid
  botId             BigInt              @map("bot_id")
  updateId          BigInt              @map("update_id")
  eventKind         TelegramInboxKind   @map("event_kind")
  encryptedPayload  Bytes               @map("encrypted_payload")
  encryptionIv      Bytes               @map("encryption_iv")
  encryptionAuthTag Bytes               @map("encryption_auth_tag")
  receivedAt        DateTime            @default(now()) @map("received_at") @db.Timestamptz(6)
  processedAt       DateTime?           @map("processed_at") @db.Timestamptz(6)
  source            TelegramSource?

  @@unique([botId, updateId], map: "telegram_inbox_bot_update_key")
  @@index([processedAt, receivedAt], map: "telegram_inbox_processing_idx")
  @@map("telegram_inbox")
}

/// Permanent source identity. Unlike HTTP idempotency records this row never expires, so a Bot
/// API redelivery can never create a second family post after the normal idempotency TTL.
model TelegramSource {
  id              String               @id @default(dbgenerated("uuidv7()")) @db.Uuid
  inboxId         String               @unique(map: "telegram_sources_inbox_id_key") @map("inbox_id") @db.Uuid
  botId           BigInt               @map("bot_id")
  chatId          BigInt               @map("chat_id")
  messageId       BigInt               @map("message_id")
  senderSubject   String               @map("sender_subject")
  userId          String               @map("user_id") @db.Uuid
  familyId        String               @map("family_id") @db.Uuid
  childId         String               @map("child_id") @db.Uuid
  kind            TelegramSourceKind
  mediaGroupId    String?              @map("media_group_id")
  status          TelegramSourceStatus @default(accepted)
  plannedMemoryId String               @map("planned_memory_id") @db.Uuid
  plannedMediaId  String?              @map("planned_media_id") @db.Uuid
  memoryId        String?              @map("memory_id") @db.Uuid
  mediaId         String?              @map("media_id") @db.Uuid
  rejectionCode   String?              @map("rejection_code")
  receiptSentAt   DateTime?            @map("receipt_sent_at") @db.Timestamptz(6)
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  inbox           TelegramInbox        @relation(fields: [inboxId], references: [id], onDelete: Cascade, map: "telegram_sources_inbox_id_fkey")
  videoReference  TelegramVideoReference?

  @@unique([botId, chatId, messageId], map: "telegram_sources_bot_chat_message_key")
  @@unique([id, familyId], map: "telegram_sources_id_family_id_key")
  @@index([botId, chatId, mediaGroupId, messageId], map: "telegram_sources_album_order_idx")
  @@index([status, updatedAt], map: "telegram_sources_status_idx")
  @@map("telegram_sources")
}

/// Durable album clock and publication result. Times are persisted so a restart cannot reset the
/// silence window or the hard deadline.
model TelegramAlbum {
  id           String              @id @default(dbgenerated("uuidv7()")) @db.Uuid
  botId        BigInt              @map("bot_id")
  chatId       BigInt              @map("chat_id")
  mediaGroupId String              @map("media_group_id")
  status       TelegramAlbumStatus @default(collecting)
  firstSeenAt  DateTime            @map("first_seen_at") @db.Timestamptz(6)
  lastSeenAt   DateTime            @map("last_seen_at") @db.Timestamptz(6)
  readyAt      DateTime            @map("ready_at") @db.Timestamptz(6)
  hardDeadline DateTime            @map("hard_deadline") @db.Timestamptz(6)
  memoryId     String?             @map("memory_id") @db.Uuid
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([botId, chatId, mediaGroupId], map: "telegram_albums_bot_chat_group_key")
  @@index([status, readyAt], map: "telegram_albums_ready_idx")
  @@map("telegram_albums")
}

/// A reply-bound caption edit intent. It carries all ownership and optimistic-concurrency data so
/// a restart or a later unrelated message can never guess which memory to mutate.
model CaptionRequest {
  id              String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  familyId        String    @map("family_id") @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  memoryId        String    @map("memory_id") @db.Uuid
  chatId          BigInt    @map("chat_id")
  promptMessageId BigInt    @map("prompt_message_id")
  expectedVersion Int       @map("expected_version")
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt      DateTime? @map("consumed_at") @db.Timestamptz(6)
  cancelledAt     DateTime? @map("cancelled_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  family          Family    @relation(fields: [familyId], references: [id], onDelete: Cascade, map: "caption_requests_family_id_fkey")
  memory          Memory    @relation(fields: [memoryId, familyId], references: [id, familyId], onDelete: Cascade, map: "caption_requests_memory_id_family_id_fkey")
  member          FamilyMember @relation(fields: [familyId, userId], references: [familyId, userId], onDelete: Restrict, map: "caption_requests_family_id_user_id_fkey")

  @@unique([chatId, promptMessageId], map: "caption_requests_chat_prompt_key")
  @@index([familyId, userId, expiresAt], map: "caption_requests_scope_expiry_idx")
  @@map("caption_requests")
}

model PilotAdmission {
  id         String                   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  provider   ExternalIdentityProvider
  subject    String
  admittedAt DateTime                 @default(now()) @map("admitted_at")
  revokedAt  DateTime?                @map("revoked_at")
  createdAt  DateTime                 @default(now()) @map("created_at")
  updatedAt  DateTime                 @updatedAt @map("updated_at")

  @@unique([provider, subject], map: "pilot_admissions_provider_subject_key")
  @@index([revokedAt], map: "pilot_admissions_revoked_at_idx")
  @@map("pilot_admissions")
}

model Family {
  id                   String              @id @default(dbgenerated("uuidv7()")) @db.Uuid
  ownerUserId          String              @map("owner_user_id") @db.Uuid
  name                 String
  timezone             String
  status               FamilyStatus        @default(active)
  storageUsedBytes     BigInt              @default(0) @map("storage_used_bytes")
  storageReservedBytes BigInt              @default(0) @map("storage_reserved_bytes")
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")
  owner                User                @relation("FamilyOwner", fields: [ownerUserId], references: [id], onDelete: Restrict, map: "families_owner_user_id_fkey")
  members              FamilyMember[]      @relation("FamilyMembers")
  ownerMembership      FamilyMember        @relation("FamilyOwnerMembership", fields: [id, ownerUserId], references: [familyId, userId], onDelete: Restrict, map: "families_owner_membership_fkey")
  children             Child[]
  invites              FamilyInvite[]
  memories             Memory[]
  mediaAssets          MediaAsset[]
  mediaReservations    UploadReservation[]
  captionRequests      CaptionRequest[]

  @@unique([id, ownerUserId], map: "families_owner_pair_key")
  @@index([ownerUserId], map: "families_owner_user_id_idx")
  @@map("families")
}

model FamilyMember {
  familyId          String              @map("family_id") @db.Uuid
  userId            String              @map("user_id") @db.Uuid
  role              FamilyRole
  familyDisplayName String?             @map("family_display_name")
  joinedAt          DateTime            @default(now()) @map("joined_at")
  revokedAt         DateTime?           @map("revoked_at")
  version           Int                 @default(1)
  family            Family              @relation("FamilyMembers", fields: [familyId], references: [id], onDelete: Cascade, map: "family_members_family_id_fkey")
  ownedFamily       Family?             @relation("FamilyOwnerMembership")
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade, map: "family_members_user_id_fkey")
  memoryLikes       MemoryLike[]
  authoredMemories  Memory[]            @relation("MemoryAuthorMembership")
  uploadedMedia     MediaAsset[]        @relation("MediaUploaderMembership")
  mediaReservations UploadReservation[] @relation("MediaReservationMembership")
  captionRequests  CaptionRequest[]

  @@id([familyId, userId])
  @@index([userId, revokedAt], map: "family_members_user_id_revoked_at_idx")
  @@map("family_members")
}

model Child {
  id            String      @id @default(dbgenerated("uuidv7()")) @db.Uuid
  familyId      String      @map("family_id") @db.Uuid
  displayName   String      @map("display_name")
  birthDate     DateTime?   @map("birth_date") @db.Date
  sex           String?     @map("sex")
  avatarMediaId String?     @unique(map: "children_avatar_media_id_key") @map("avatar_media_id") @db.Uuid
  avatarCrop    Json?       @map("avatar_crop")
  version       Int         @default(1)
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")
  family        Family      @relation(fields: [familyId], references: [id], onDelete: Cascade, map: "children_family_id_fkey")
  memories      Memory[]
  avatarMedia   MediaAsset? @relation("ChildAvatar", fields: [avatarMediaId, familyId], references: [id, familyId], onDelete: Restrict, map: "children_avatar_media_id_family_id_fkey")

  @@unique([id, familyId], map: "children_id_family_id_key")
  @@index([familyId], map: "children_family_id_idx")
  @@map("children")
}

model FamilyInvite {
  id                 String     @id @default(dbgenerated("uuidv7()")) @db.Uuid
  familyId           String     @map("family_id") @db.Uuid
  role               FamilyRole
  inviteeDisplayName String?    @map("invitee_display_name")
  tokenHash          String     @unique(map: "family_invites_token_hash_key") @map("token_hash")
  expiresAt          DateTime   @map("expires_at")
  createdBy          String     @map("created_by") @db.Uuid
  acceptedBy         String?    @map("accepted_by") @db.Uuid
  acceptedAt         DateTime?  @map("accepted_at")
  revokedAt          DateTime?  @map("revoked_at")
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @updatedAt @map("updated_at")
  family             Family     @relation(fields: [familyId], references: [id], onDelete: Cascade, map: "family_invites_family_id_fkey")
  creator            User       @relation("InviteCreator", fields: [createdBy], references: [id], onDelete: Restrict, map: "family_invites_created_by_fkey")
  acceptor           User?      @relation("InviteAcceptor", fields: [acceptedBy], references: [id], onDelete: Restrict, map: "family_invites_accepted_by_fkey")

  @@index([familyId, expiresAt], map: "family_invites_family_id_expires_at_idx")
  @@map("family_invites")
}

model IdempotencyRecord {
  id               String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  actorUserId      String   @map("actor_user_id") @db.Uuid
  operation        String
  key              String   @db.Uuid
  payloadHash      String   @map("payload_hash")
  resourceId       String   @map("resource_id") @db.Uuid
  responseSnapshot Json     @map("response_snapshot")
  expiresAt        DateTime @map("expires_at")
  createdAt        DateTime @default(now()) @map("created_at")
  actor            User     @relation(fields: [actorUserId], references: [id], onDelete: Cascade, map: "idempotency_records_actor_user_id_fkey")

  @@unique([actorUserId, operation, key], map: "idempotency_records_actor_operation_key_key")
  @@index([expiresAt], map: "idempotency_records_expires_at_idx")
  @@map("idempotency_records")
}

model Memory {
  id               String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  familyId         String        @map("family_id") @db.Uuid
  childId          String        @map("child_id") @db.Uuid
  authorId         String        @map("author_id") @db.Uuid
  kind             MemoryKind
  body             String
  occurredAt       DateTime      @map("occurred_at") @db.Timestamptz(6)
  status           MemoryStatus  @default(published)
  version          Int           @default(1)
  createdSequence  BigInt        @default(autoincrement()) @map("created_sequence")
  deletedAt        DateTime?     @map("deleted_at") @db.Timestamptz(6)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  family           Family        @relation(fields: [familyId], references: [id], onDelete: Cascade, map: "memories_family_id_fkey")
  child            Child         @relation(fields: [childId, familyId], references: [id, familyId], onDelete: Restrict, map: "memories_child_id_family_id_fkey")
  author           User          @relation("MemoryAuthor", fields: [authorId], references: [id], onDelete: Restrict, map: "memories_author_id_fkey")
  authorMembership FamilyMember  @relation("MemoryAuthorMembership", fields: [familyId, authorId], references: [familyId, userId], onDelete: Restrict, map: "memories_author_membership_fkey")
  likes            MemoryLike[]
  media            MemoryMedia[]
  captionRequests  CaptionRequest[]
  telegramVideoReference TelegramVideoReference?

  @@unique([id, familyId], map: "memories_id_family_id_key")
  @@index([familyId, status, occurredAt(sort: Desc), id(sort: Desc)], map: "memories_feed_idx")
  @@index([familyId, kind, status, occurredAt(sort: Desc), id(sort: Desc)], map: "memories_kind_feed_idx")
  @@map("memories")
}

model MemoryLike {
  familyId  String       @map("family_id") @db.Uuid
  memoryId  String       @map("memory_id") @db.Uuid
  userId    String       @map("user_id") @db.Uuid
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  memory    Memory       @relation(fields: [memoryId, familyId], references: [id, familyId], onDelete: Cascade, map: "memory_likes_memory_id_family_id_fkey")
  member    FamilyMember @relation(fields: [familyId, userId], references: [familyId, userId], onDelete: Restrict, map: "memory_likes_family_id_user_id_fkey")

  @@id([memoryId, userId])
  @@index([familyId, memoryId], map: "memory_likes_family_id_memory_id_idx")
  @@map("memory_likes")
}

model MemoryMedia {
  familyId String     @map("family_id") @db.Uuid
  memoryId String     @map("memory_id") @db.Uuid
  mediaId  String     @map("media_id") @db.Uuid
  position Int
  memory   Memory     @relation(fields: [memoryId, familyId], references: [id, familyId], onDelete: Cascade, map: "memory_media_memory_id_family_id_fkey")
  asset    MediaAsset @relation(fields: [mediaId, familyId], references: [id, familyId], onDelete: Restrict, map: "memory_media_media_id_family_id_fkey")

  @@id([memoryId, position])
  @@unique([mediaId], map: "memory_media_media_id_key")
  @@index([familyId, mediaId], map: "memory_media_family_id_media_id_idx")
  @@map("memory_media")
}

model MediaAsset {
  id                 String               @id @default(dbgenerated("uuidv7()")) @db.Uuid
  familyId           String               @map("family_id") @db.Uuid
  uploaderId         String               @map("uploader_id") @db.Uuid
  sourceKind         MediaSourceKind      @map("source_kind")
  purpose            MediaAssetPurpose
  mediaKind          MediaAssetKind       @map("media_kind")
  originalKey        String               @unique(map: "media_assets_original_key_key") @map("original_key")
  declaredMime       String               @map("declared_mime")
  verifiedMime       String?              @map("verified_mime")
  sha256             String?
  byteSize           BigInt               @map("byte_size")
  width              Int?
  height             Int?
  durationMs         Int?                 @map("duration_ms")
  waveform           Json?                @map("waveform")
  processingErrorCode String?             @map("processing_error_code")
  originalStatus     MediaOriginalStatus  @default(pending) @map("original_status")
  renditionStatus    MediaRenditionStatus @default(pending) @map("rendition_status")
  deletedAt          DateTime?            @map("deleted_at") @db.Timestamptz(6)
  storageDeletedAt   DateTime?            @map("storage_deleted_at") @db.Timestamptz(6)
  createdAt          DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  family             Family               @relation(fields: [familyId], references: [id], onDelete: Cascade, map: "media_assets_family_id_fkey")
  uploader           User                 @relation("MediaUploader", fields: [uploaderId], references: [id], onDelete: Restrict, map: "media_assets_uploader_id_fkey")
  uploaderMembership FamilyMember         @relation("MediaUploaderMembership", fields: [familyId, uploaderId], references: [familyId, userId], onDelete: Restrict, map: "media_assets_uploader_membership_fkey")
  variants           MediaVariant[]
  reservation        UploadReservation?
  memories           MemoryMedia[]
  telegramVideoThumbnailFor TelegramVideoReference? @relation("TelegramVideoThumbnail")
  avatarForChildren  Child[]              @relation("ChildAvatar")

  @@unique([id, familyId], map: "media_assets_id_family_id_key")
  @@index([familyId, originalStatus, deletedAt], map: "media_assets_family_status_idx")
  @@map("media_assets")
}

/// Adapter-owned reference for a video which remains on Telegram. Its source relation retains
/// the original private-chat message identity server-side; the encrypted file id is a legacy and
/// unsupported-context fallback, never a public DTO field.
model TelegramVideoReference {
  id                 String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  sourceId           String         @unique(map: "telegram_video_references_source_id_key") @map("source_id") @db.Uuid
  memoryId           String         @unique(map: "telegram_video_references_memory_id_key") @map("memory_id") @db.Uuid
  familyId           String         @map("family_id") @db.Uuid
  fileIdCiphertext   Bytes          @map("file_id_ciphertext")
  encryptionIv       Bytes          @map("encryption_iv")
  encryptionAuthTag  Bytes          @map("encryption_auth_tag")
  fileUniqueId       String         @map("file_unique_id")
  width              Int?
  height             Int?
  durationMs         Int?           @map("duration_ms")
  thumbnailMediaId   String?        @map("thumbnail_media_id") @db.Uuid
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  source             TelegramSource @relation(fields: [sourceId, familyId], references: [id, familyId], onDelete: Cascade, map: "telegram_video_references_source_id_family_id_fkey")
  memory             Memory         @relation(fields: [memoryId, familyId], references: [id, familyId], onDelete: Cascade, map: "telegram_video_references_memory_id_family_id_fkey")
  thumbnailMedia     MediaAsset?    @relation("TelegramVideoThumbnail", fields: [thumbnailMediaId, familyId], references: [id, familyId], onDelete: Restrict, map: "telegram_video_references_thumbnail_media_id_family_id_fkey")
  deliveries         TelegramVideoDelivery[]
  deliveryTargets    TelegramVideoDeliveryTarget[]

  @@index([familyId], map: "telegram_video_references_family_id_idx")
  @@unique([sourceId, familyId], map: "telegram_video_references_source_id_family_id_key")
  @@unique([memoryId, familyId], map: "telegram_video_references_memory_id_family_id_key")
  @@unique([thumbnailMediaId, familyId], map: "telegram_video_references_thumbnail_media_id_family_id_key")

  @@map("telegram_video_references")
}

/// Short-lived, requester-bound navigation pointers for Telegram-only videos. The pointer does
/// not grant access: the bot verifies the same user, an active membership and a live memory.
model TelegramVideoDelivery {
  id          String                 @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tokenHash   String                 @unique(map: "telegram_video_deliveries_token_hash_key") @map("token_hash")
  referenceId String                 @map("reference_id") @db.Uuid
  familyId    String                 @map("family_id") @db.Uuid
  userId      String                 @map("user_id") @db.Uuid
  expiresAt   DateTime               @map("expires_at") @db.Timestamptz(6)
  claimToken  String?                @unique(map: "telegram_video_deliveries_claim_token_key") @map("claim_token") @db.Uuid
  claimedAt   DateTime?              @map("claimed_at") @db.Timestamptz(6)
  deliveredAt DateTime?              @map("delivered_at") @db.Timestamptz(6)
  ambiguousAt DateTime?              @map("ambiguous_at") @db.Timestamptz(6)
  deniedAt    DateTime?              @map("denied_at") @db.Timestamptz(6)
  createdAt   DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  reference   TelegramVideoReference @relation(fields: [referenceId], references: [id], onDelete: Cascade, map: "telegram_video_deliveries_reference_id_fkey")
  navigationReply TelegramVideoNavigationReply?

  @@index([familyId, userId, expiresAt], map: "telegram_video_deliveries_member_expiry_idx")
  @@index([expiresAt], map: "telegram_video_deliveries_expires_at_idx")
  @@map("telegram_video_deliveries")
}

/// A short-lived bot message that quotes the original private-chat video. Keeping its exact
/// target here makes cleanup durable and prevents an outbox retry from deleting any other chat
/// message. Neither Telegram identifier is exposed through application DTOs.
model TelegramVideoNavigationReply {
  id          String                 @id @default(dbgenerated("uuidv7()")) @db.Uuid
  deliveryId  String                 @unique(map: "telegram_video_navigation_replies_delivery_id_key") @map("delivery_id") @db.Uuid
  chatId      BigInt                 @map("chat_id")
  messageId   BigInt                 @map("message_id")
  cleanupAt   DateTime               @map("cleanup_at") @db.Timestamptz(6)
  deletedAt   DateTime?              @map("deleted_at") @db.Timestamptz(6)
  createdAt   DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  delivery    TelegramVideoDelivery  @relation(fields: [deliveryId], references: [id], onDelete: Cascade, map: "telegram_video_navigation_replies_delivery_id_fkey")

  @@index([cleanupAt, deletedAt], map: "telegram_video_navigation_replies_cleanup_idx")
  @@unique([chatId, messageId], map: "telegram_video_navigation_replies_chat_message_key")
  @@map("telegram_video_navigation_replies")
}

/// One reusable, server-only Telegram navigation target per viewer and Telegram-origin video.
/// A target is either the uploader's original private-chat message or one bot-delivered copy.
model TelegramVideoDeliveryTarget {
  id          String                    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  referenceId String                    @map("reference_id") @db.Uuid
  userId      String                    @map("user_id") @db.Uuid
  chatId      BigInt                    @map("chat_id")
  messageId   BigInt                    @map("message_id")
  source      TelegramVideoTargetSource
  createdAt   DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)
  reference   TelegramVideoReference    @relation(fields: [referenceId], references: [id], onDelete: Cascade, map: "telegram_video_delivery_targets_reference_id_fkey")
  user        User                      @relation(fields: [userId], references: [id], onDelete: Cascade, map: "telegram_video_delivery_targets_user_id_fkey")

  @@unique([referenceId, userId], map: "telegram_video_delivery_targets_reference_user_key")
  @@index([userId], map: "telegram_video_delivery_targets_user_id_idx")
  @@unique([chatId, messageId], map: "telegram_video_delivery_targets_chat_message_key")
  @@map("telegram_video_delivery_targets")
}


{
  "version": 2,
  "rules": [
    {
      "impact": "docs",
      "prefixes": ["docs/", "templates/", "REPO_MAP.md"],
      "commandIds": ["template"]
    },
    {
      "impact": "media",
      "prefixes": [
        "backend/src/modules/media/",
        "backend/src/modules/telegram/",
        "backend/src/storage/"
      ],
      "commandIds": ["architecture", "backend-unit", "backend-integration"]
    },
    {
      "impact": "contracts",
      "prefixes": ["packages/contracts/"],
      "commandIds": ["architecture", "typecheck", "contracts", "backend-unit", "webapp"]
    },
    {
      "impact": "auth",
      "prefixes": ["backend/src/modules/auth/"],
      "commandIds": ["architecture", "backend-unit", "backend-integration"]
    },
    {
      "impact": "families",
      "prefixes": ["backend/src/modules/families/"],
      "commandIds": ["architecture", "typecheck", "contracts", "backend-unit", "backend-integration"]
    },
    {
      "impact": "memories",
      "prefixes": ["backend/src/modules/memories/"],
      "commandIds": ["architecture", "typecheck", "contracts", "backend-unit", "backend-integration"]
    },
    {
      "impact": "schema",
      "prefixes": ["backend/prisma/"],
      "commandIds": ["architecture", "typecheck", "backend-integration"]
    },
    {
      "impact": "webapp",
      "prefixes": ["webapp/"],
      "commandIds": ["architecture", "typecheck", "webapp", "build-webapp"]
    },
    {
      "impact": "infrastructure",
      "prefixes": [
        ".env.example",
        ".bun-version",
        "backend/.env.example",
        "backend/package.json",
        "backend/Dockerfile",
        "backend/src/app.ts",
        "backend/src/env.ts",
        "backend/src/index.ts",
        "backend/src/outbox/",
        "backend/src/runtime.ts",
        "backend/src/worker.ts",
        "bun.lock",
        "bunfig.toml",
        "docker-compose.yml",
        "infra/",
        "package.json",
        "scripts/"
      ],
      "commandIds": [
        "architecture",
        "template",
        "typecheck",
        "contracts",
        "backend-unit",
        "backend-integration",
        "webapp",
        "build-webapp"
      ]
    }
  ]
}

{
  "version": 2,
  "rules": [
    {
      "impact": "docs",
      "prefixes": ["docs/", "templates/", "REPO_MAP.md"],
      "commandIds": ["template"]
    },
    {
      "impact": "media",
      "prefixes": [
        "backend/src/modules/media/",
        "backend/src/modules/telegram/",
        "backend/src/storage/"
      ],
      "commandIds": ["architecture", "typecheck", "backend-unit", "backend-integration", "e2e-release", "storage-s3"]
    },
    {
      "impact": "contracts",
      "prefixes": ["packages/contracts/"],
      "commandIds": ["architecture", "typecheck", "contracts", "backend-unit", "webapp", "e2e-release"]
    },
    {
      "impact": "auth",
      "prefixes": ["backend/src/modules/auth/"],
      "commandIds": ["architecture", "typecheck", "backend-unit", "backend-integration", "e2e-release"]
    },
    {
      "impact": "families",
      "prefixes": ["backend/src/modules/families/"],
      "commandIds": ["architecture", "typecheck", "contracts", "backend-unit", "backend-integration", "e2e-release"]
    },
    {
      "impact": "memories",
      "prefixes": ["backend/src/modules/memories/"],
      "commandIds": ["architecture", "typecheck", "contracts", "backend-unit", "backend-integration", "e2e-release"]
    },
    {
      "impact": "schema",
      "prefixes": ["backend/prisma/"],
      "commandIds": ["architecture", "typecheck", "backend-integration", "e2e-release"]
    },
    {
      "impact": "webapp",
      "prefixes": ["webapp/"],
      "commandIds": ["architecture", "typecheck", "webapp", "build-webapp", "lint", "e2e-release"]
    },
    {
      "impact": "infrastructure",
      "prefixes": [
        ".env.example",
        ".bun-version",
        "backend/.env.example",
        "backend/package.json",
        "backend/Dockerfile",
        "backend/src/app.ts",
        "backend/src/env.ts",
        "backend/src/index.ts",
        "backend/src/outbox/",
        "backend/src/runtime.ts",
        "backend/src/worker.ts",
        "bun.lock",
        "bunfig.toml",
        "docker-compose.yml",
        "infra/",
        "package.json",
        "scripts/"
      ],
      "commandIds": [
        "architecture",
        "template",
        "typecheck",
        "audit",
        "lint",
        "verification-tools",
        "infra-tests",
        "contracts",
        "backend-unit",
        "backend-integration",
        "webapp",
        "e2e-release",
        "build-contracts",
        "storage-s3",
        "docker-smoke"
      ]
    },
    {
      "impact": "manifests",
      "prefixes": [
        "webapp/package.json",
        "website/package.json",
        "packages/contracts/package.json"
      ],
      "commandIds": ["audit", "typecheck"]
    },
    {
      "impact": "website",
      "prefixes": ["website/"],
      "commandIds": ["architecture", "typecheck", "website-tests", "build-contracts"]
    }
  ]
}

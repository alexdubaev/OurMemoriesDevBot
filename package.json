{
  "name": "vibecoding-template",
  "private": true,
  "version": "0.0.0",
  "license": "Apache-2.0",
  "packageManager": "bun@1.4.0",
  "type": "module",
  "workspaces": [
    "webapp",
    "website",
    "backend",
    "packages/*"
  ],
  "overrides": {
    "@babel/core": "^7.29.7",
    "@hono/node-server": "^2.1.0",
    "brace-expansion": "^5.0.12",
    "browserslist": "^4.28.9",
    "deepmerge-ts": "^8.0.2",
    "esbuild": "^0.28.1",
    "fast-uri": "^3.1.8",
    "find-my-way": "^9.7.0",
    "hono": "4.13.7",
    "http-cache-semantics": "4.3.0",
    "js-yaml": "4.3.2",
    "mysql2": "^3.24.3",
    "nanoid": "^3.3.18",
    "postcss": "^8.5.26",
    "qs": "^6.16.0",
    "seroval": "1.6.3",
    "sharp": "0.35.5",
    "smol-toml": "1.9.0",
    "source-map-js": "^1.2.2",
    "svgo": "4.1.0",
    "valibot": "^1.4.2",
    "yaml": "^2.9.0"
  },
  "scripts": {
    "dev": "bun run --filter '*' --parallel dev",
    "dev:webapp": "bun run --cwd webapp dev",
    "dev:website": "bun run --cwd website dev",
    "dev:backend": "bun run --cwd backend dev",
    "acceptance:check": "bun scripts/dev-acceptance-check.mjs",
    "storybook:webapp": "bun run --cwd webapp storybook",
    "storybook:website": "bun run --cwd website storybook",
    "storybook:build": "bun run storybook:build:webapp && bun run storybook:build:website",
    "storybook:build:webapp": "bun run --cwd webapp storybook:build",
    "storybook:build:website": "bun run --cwd website storybook:build",
    "dev:backend:s3": "bun scripts/storage-local.mjs dev-backend",
    "dev:seed": "bun run --cwd backend prisma:seed",
    "build": "bun run --filter '*' --sequential build",
    "build:webapp": "bun run --cwd webapp build",
    "build:website": "bun run --cwd website build",
    "build:backend": "bun run --cwd backend build",
    "check": "bun run template:check && bun run architecture:check && bun run audit && bun run typecheck && bun run lint && bun run test && bun run test:build-contracts",
    "template:check": "bun scripts/template-check.mjs",
    "architecture:check": "bun scripts/architecture-check.mjs",
    "verify:plan": "bun scripts/verify-plan.mjs",
    "audit": "bun scripts/dependency-audit.mjs",
    "static:precompress": "bun scripts/precompress-static.mjs",
    "lint": "bun run --cwd webapp lint",
    "mobile:template:check": "bun scripts/check-mobile-template.mjs",
    "infra:bootstrap": "bun scripts/infra.mjs bootstrap",
    "infra:apply": "bun scripts/infra.mjs apply",
    "infra:import": "bun scripts/infra.mjs import",
    "infra:output": "bun scripts/infra.mjs output",
    "infra:plan": "bun scripts/infra.mjs plan",
    "release": "bun scripts/infra.mjs release",
    "storage:local:start": "bun scripts/storage-local.mjs start",
    "storage:local:status": "bun scripts/storage-local.mjs status",
    "storage:local:stop": "bun scripts/storage-local.mjs stop",
    "storage:local:env": "bun scripts/storage-local.mjs env",
    "typecheck": "bun run --filter '*' --sequential typecheck",
    "typecheck:webapp": "bun run --cwd webapp typecheck",
    "typecheck:website": "bun run --cwd website typecheck",
    "typecheck:backend": "bun run --cwd backend typecheck",
    "test": "bun run test:infra && bun run test:contracts && bun run test:backend && bun run test:webapp && bun run test:website",
    "test:verification-tools": "bun test tests/verify-plan.test.ts tests/require-release-verification.test.ts",
    "test:infra": "bun test ./scripts/",
    "test:terraform": "bun scripts/terraform-test.mjs",
    "test:contracts": "bun run --cwd packages/contracts test",
    "test:backend": "bun run --cwd backend test",
    "test:backend:unit": "bun run --cwd backend test:unit",
    "test:backend:integration": "bun run --cwd backend test:integration",
    "test:storage:s3": "bun scripts/storage-local.mjs test",
    "test:webapp": "bun run --cwd webapp test",
    "test:website": "bun run --cwd website test",
    "test:build-contracts": "bun run build:webapp && bun run build:website && bun run --cwd webapp test:build-contracts && bun run --cwd website test:build-contracts",
    "smoke:backend:docker": "bun run --cwd backend smoke:docker",
    "e2e:webapp": "bun run --cwd webapp e2e",
    "e2e:webapp:release": "bun run e2e:webapp && bun run --cwd webapp e2e -- --config e2e/private-video-poster.playwright.config.ts && bun run --cwd webapp e2e -- --config e2e/warm-navigation-cache.playwright.config.ts",
    "e2e:webapp:s3": "bun scripts/storage-local.mjs e2e"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "10.5.10",
    "@storybook/addon-docs": "10.5.10",
    "@storybook/react-vite": "10.5.10",
    "storybook": "10.5.10"
  }
}

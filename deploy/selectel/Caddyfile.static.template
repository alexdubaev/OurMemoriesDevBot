:80 {
	root * /srv
	encode gzip zstd
	route {
		header Cache-Control "no-cache"
		@fingerprintedAssets {
			file
			path_regexp fingerprinted ^/assets/[^/]+-[A-Za-z0-9_-]{8}\.(?:js|css|webp|png|jpg|jpeg|avif|woff2)$
		}
		header @fingerprintedAssets Cache-Control "public, max-age=31536000, immutable"
		@controlRoot path /control
		redir @controlRoot /control/ 308
		handle /control/ {
			rewrite * /control/index.html
			file_server
		}
		handle /control/index.html {
			file_server
		}
		handle /control/* {
			file_server
		}
		@staticAssets path /assets/* /control/assets/*
		handle @staticAssets {
			file_server
		}
		try_files {path} /index.html
		file_server
	}
}
